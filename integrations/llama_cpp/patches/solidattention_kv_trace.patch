+static void llama_solidattention_attention_residency_gate(
+        const char * view,
+        int32_t layer_id,
+        uint32_t n_kv,
+        uint32_t n_stream) {
+    if (!llama_solidattention_kv_attention_gate_enabled()) {
+        return;
+    }
+
+    llama_solidattention_kv_bridge_summary.attention_gate_enabled = 1;
+    ++llama_solidattention_kv_bridge_summary.attention_gate_view_count;
+    if (view && std::strcmp(view, "k") == 0) {
+        ++llama_solidattention_kv_bridge_summary.attention_gate_k_view_count;
+    } else if (view && std::strcmp(view, "v") == 0) {
+        ++llama_solidattention_kv_bridge_summary.attention_gate_v_view_count;
+    }
+
+    uint32_t required_block_count = 0;
+    uint32_t ready_block_count = 0;
+    uint32_t missing_block_count = 0;
+    uint32_t pending_mutation_count = 0;
+
+    for (uint32_t i = 0; i < llama_solidattention_kv_command_record_count; ++i) {
+        const auto & command = llama_solidattention_kv_command_records[i];
+        if (!llama_solidattention_attention_command_overlaps_view(command, layer_id, n_kv) ||
+                llama_solidattention_attention_command_key_seen(i, command, layer_id, n_kv)) {
+            continue;
+        }
+
+        ++required_block_count;
+        auto * record = llama_solidattention_find_staging_record_by_key(
+                command.layer_id,
+                command.block_id,
+                command.start_token,
+                command.end_token);
+        if (!record || !record->vram_buffer) {
+            ++missing_block_count;
+        } else if (!record->tensor_mutation_checked) {
+            ++pending_mutation_count;
+        } else {
+            ++ready_block_count;
+        }
+    }
+
+    if (required_block_count == 0) {
+        ++llama_solidattention_kv_bridge_summary.attention_gate_no_required_view_count;
+    }
+    llama_solidattention_kv_bridge_summary.attention_gate_required_block_count += required_block_count;
+    llama_solidattention_kv_bridge_summary.attention_gate_ready_block_count += ready_block_count;
+    llama_solidattention_kv_bridge_summary.attention_gate_missing_block_count += missing_block_count;
+    llama_solidattention_kv_bridge_summary.attention_gate_pending_mutation_count += pending_mutation_count;
+
+    llama_solidattention_write_attention_gate_event(
+            view,
+            layer_id,
+            n_kv,
+            n_stream,
+            required_block_count,
+            ready_block_count,
+            missing_block_count,
+            pending_mutation_count);
+    llama_solidattention_write_kv_command_bridge_summary();
+}
+
+static void llama_solidattention_kv_command_bridge_apply(
+        int32_t layer_id,
+        uint32_t block_id,
+        int64_t start_token,
+        int64_t end_token,
+        uint32_t cache_size,
+        uint32_t n_tokens,
+        uint32_t n_stream,
+        ggml_tensor * k_tensor,
+        ggml_tensor * v_tensor,
+        bool v_trans) {
+    if (!llama_solidattention_kv_command_bridge_enabled() ||
+            !llama_solidattention_kv_command_records_ready ||
+            !llama_solidattention_kv_command_records_valid) {
+        return;
+    }
+
+    ++llama_solidattention_kv_bridge_summary.runtime_layer_event_count;
+    llama_solidattention_kv_bridge_summary.command_record_count = llama_solidattention_kv_command_record_count;
+    llama_solidattention_kv_bridge_summary.cache_size = cache_size;
+    llama_solidattention_kv_bridge_summary.n_tokens_last = n_tokens;
+    llama_solidattention_kv_bridge_summary.n_stream_last = n_stream;
+
+    uint32_t matches = 0;
+    const char * initial_shadow_location = nullptr;
+    for (uint32_t i = 0; i < llama_solidattention_kv_command_record_count; ++i) {
+        const auto & command = llama_solidattention_kv_command_records[i];
+        if (llama_solidattention_kv_command_matches_runtime(command, layer_id, block_id, start_token, end_token)) {
+            initial_shadow_location = command.source;
+            break;
+        }
+    }
+
+    if (initial_shadow_location) {
+        llama_solidattention_reset_shadow_record_for_runtime_event(layer_id, block_id, start_token, end_token, initial_shadow_location);
+    }
+
+    for (uint32_t i = 0; i < llama_solidattention_kv_command_record_count; ++i) {
+        const auto & command = llama_solidattention_kv_command_records[i];
+        if (!llama_solidattention_kv_command_matches_runtime(command, layer_id, block_id, start_token, end_token)) {
+            continue;
+        }
+
+        auto * shadow = llama_solidattention_find_or_create_shadow_record(layer_id, block_id, start_token, end_token, command.source);
+        char shadow_before[16];
+        char shadow_after[16];
+        bool shadow_source_match = false;
+        if (shadow) {
+            std::snprintf(shadow_before, sizeof(shadow_before), "%s", shadow->location);
+            shadow_source_match = std::strcmp(shadow_before, command.source) == 0;
+            std::snprintf(shadow->location, sizeof(shadow->location), "%s", command.target);
+            std::snprintf(shadow_after, sizeof(shadow_after), "%s", shadow->location);
+        } else {
+            std::snprintf(shadow_before, sizeof(shadow_before), "%s", command.source);
+            std::snprintf(shadow_after, sizeof(shadow_after), "%s", command.target);
+            shadow_source_match = true;
+        }
+
+        ++matches;
+        ++llama_solidattention_kv_bridge_summary.matched_command_count;
+        ++llama_solidattention_kv_bridge_summary.shadow_transition_count;
+        if (shadow_source_match) {
+            ++llama_solidattention_kv_bridge_summary.shadow_source_match_count;
+        } else {
+            ++llama_solidattention_kv_bridge_summary.shadow_source_mismatch_count;
+        }
+
+        const char * intent_kind = llama_solidattention_movement_intent_kind(command);
+        llama_solidattention_record_movement_intent(command, intent_kind);
+        llama_solidattention_execute_movement_intent_stub(command, intent_kind);
+        if (auto * staging_record = llama_solidattention_find_staging_record(command)) {
+            llama_solidattention_executor_tensor_mutation_gate(*staging_record, k_tensor, v_tensor, v_trans);
+        }
+
+        if (std::strcmp(command.op, "kv_load") == 0) {
+            ++llama_solidattention_kv_bridge_summary.kv_load_count;
+        } else if (std::strcmp(command.op, "kv_prefetch") == 0) {
+            ++llama_solidattention_kv_bridge_summary.kv_prefetch_count;
+        } else if (std::strcmp(command.op, "kv_compute") == 0) {
+            ++llama_solidattention_kv_bridge_summary.kv_compute_count;
+        } else if (std::strcmp(command.op, "kv_evict") == 0) {
+            ++llama_solidattention_kv_bridge_summary.kv_evict_count;
+        }
+
+        if ((std::strcmp(command.op, "kv_load") == 0 || std::strcmp(command.op, "kv_prefetch") == 0) && std::strcmp(command.source, "ssd") == 0) {
+            ++llama_solidattention_kv_bridge_summary.ssd_read_command_count;
+            llama_solidattention_kv_bridge_summary.ssd_read_bytes += (uint64_t) command.size_bytes;
+        }
+
+        if (std::strcmp(command.op, "kv_evict") == 0 && std::strcmp(command.target, "ssd") == 0) {
+            ++llama_solidattention_kv_bridge_summary.ssd_write_command_count;
+            llama_solidattention_kv_bridge_summary.ssd_write_bytes += (uint64_t) command.size_bytes;
+        }
+
+        llama_solidattention_refresh_shadow_location_counts();
+        llama_solidattention_write_kv_command_bridge_event(
+                i,
+                command,
+                layer_id,
+                block_id,
+                start_token,
+                end_token,
+                shadow_before,
+                shadow_after,
+                shadow_source_match,
+                intent_kind,
+                cache_size,
+                n_tokens,
+                n_stream);
+    }
+
+    if (matches == 0) {
+        ++llama_solidattention_kv_bridge_summary.unmatched_layer_event_count;
+    }
+
+    llama_solidattention_write_kv_command_bridge_summary();
+}
+
+static void llama_solidattention_kv_command_dry_run_once(
+        const std::vector<uint32_t> & layer_ids,
+        uint32_t cache_size) {
+    if (!llama_solidattention_kv_command_enabled()) {
+        return;
+    }
+
+    static bool done = false;
+    if (done) {
+        return;
+    }
+    done = true;
+
+    llama_solidattention_kv_command_record_count = 0;
+    llama_solidattention_kv_shadow_record_count = 0;
+    llama_solidattention_free_executor_staging_records();
+    llama_solidattention_kv_bridge_summary = llama_solidattention_kv_command_bridge_summary();
+    llama_solidattention_kv_command_records_ready = false;
+    llama_solidattention_kv_command_records_valid = false;
+
+    llama_solidattention_kv_command_summary summary;
+    summary.layer_count = (uint32_t) layer_ids.size();
+    summary.cache_size = cache_size;
+
+    const char * command_path = std::getenv("LLAMA_SOLIDATTENTION_KV_COMMAND_PATH");
+    FILE * fp = std::fopen(command_path, "r");
+    if (!fp) {
+        summary.command_file_open_error = 1;
+        llama_solidattention_write_kv_command_summary("missing_command_file", summary);
+        return;
+    }
+
+    char line[8192];
+    while (std::fgets(line, sizeof(line), fp)) {
+        const char * start = llama_solidattention_skip_json_ws(line);
+        if (*start == '\0' || *start == '\n' || *start == '\r') {
+            continue;
+        }
+
+        ++summary.command_count;
+
+        char op[32];
+        char source[16];
+        char target[16];
+        int64_t layer_id = -1;
+        int64_t block_id = -1;
+        int64_t start_token = -1;
+        int64_t end_token = -1;
+        int64_t size_bytes = -1;
+        int64_t ssd_offset = -1;
+        bool blocking = false;
+
+        const bool fields_ok =
+            llama_solidattention_json_string(line, "op", op, sizeof(op)) &&
+            llama_solidattention_json_i64(line, "layer_id", &layer_id) &&
+            llama_solidattention_json_i64(line, "block_id", &block_id) &&
+            llama_solidattention_json_i64(line, "start_token", &start_token) &&
+            llama_solidattention_json_i64(line, "end_token", &end_token) &&
+            llama_solidattention_json_i64(line, "size_bytes", &size_bytes) &&
+            llama_solidattention_json_string(line, "source", source, sizeof(source)) &&
+            llama_solidattention_json_string(line, "target", target, sizeof(target)) &&
+            llama_solidattention_json_i64(line, "ssd_offset", &ssd_offset) &&
+            llama_solidattention_json_bool(line, "blocking", &blocking);
+
+        bool valid = fields_ok;
+        if (!fields_ok) {
+            ++summary.missing_field_count;
+        }
+
+        if (valid && !llama_solidattention_is_command_op(op)) {
+            ++summary.unknown_op_count;
+            valid = false;
+        }
+
+        if (valid && !llama_solidattention_has_layer_id(layer_ids, layer_id)) {
+            ++summary.unknown_layer_count;
+            valid = false;
+        }
+
+        if (valid && (block_id < 0 || (uint64_t) block_id >= (uint64_t) cache_size)) {
+            ++summary.out_of_range_block_count;
+            valid = false;
+        }
+
+        if (valid && (start_token < 0 || end_token <= start_token)) {
+            ++summary.invalid_token_range_count;
+            valid = false;
+        }
+
+        if (valid && (size_bytes <= 0 || ssd_offset < 0)) {
+            ++summary.invalid_size_count;
+            valid = false;
+        }
+
+        if (valid && (!llama_solidattention_is_location(source) || !llama_solidattention_is_location(target))) {
+            ++summary.invalid_location_count;
+            valid = false;
+        }
+
+        if (valid && std::strcmp(op, "kv_compute") == 0 && (std::strcmp(source, "vram") != 0 || std::strcmp(target, "vram") != 0)) {
+            ++summary.invalid_location_count;
+            valid = false;
+        }
+
+        if (valid && std::strcmp(op, "kv_evict") == 0 && std::strcmp(target, "ssd") != 0) {
+            ++summary.invalid_location_count;
+            valid = false;
+        }
+
+        if (valid) {
+            llama_solidattention_record_command_counts(summary, op, source, target, size_bytes);
+            llama_solidattention_store_command_record(op, source, target, layer_id, block_id, start_token, end_token, size_bytes, ssd_offset, blocking);
+        } else {
+            ++summary.invalid_command_count;
+        }
+    }
+
+    std::fclose(fp);
+
+    llama_solidattention_kv_command_records_ready = true;
+    llama_solidattention_kv_command_records_valid = summary.invalid_command_count == 0;
+
+    llama_solidattention_write_kv_command_summary(
+            summary.invalid_command_count == 0 ? "ok" : "invalid",
+            summary);
+}
