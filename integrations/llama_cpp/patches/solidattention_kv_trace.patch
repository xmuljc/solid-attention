+static llama_solidattention_kv_staging_record * llama_solidattention_executor_ensure_dram_source(
+        const llama_solidattention_kv_command_record & command) {
+    auto * record = llama_solidattention_find_staging_record(command);
+    if (record && record->dram_buffer) {
+        return record;
+    }
+    if (!llama_solidattention_kv_executor_seed_missing_sources()) {
+        ++llama_solidattention_kv_bridge_summary.executor_missing_source_count;
+        return nullptr;
+    }
+    void * buffer = llama_solidattention_executor_alloc_and_read_backing(command, false);
+    if (!buffer || !llama_solidattention_executor_assign_dram_buffer(command, buffer)) {
+        ++llama_solidattention_kv_bridge_summary.executor_missing_source_count;
+        return nullptr;
+    }
+    ++llama_solidattention_kv_bridge_summary.executor_lazy_source_seed_count;
+    llama_solidattention_kv_bridge_summary.executor_lazy_source_seed_bytes += (uint64_t) command.size_bytes;
+    return llama_solidattention_find_staging_record(command);
+}
