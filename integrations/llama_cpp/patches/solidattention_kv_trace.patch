+static bool llama_solidattention_executor_assign_dram_buffer(
+        const llama_solidattention_kv_command_record & command,
+        void * buffer) {
+    auto * record = llama_solidattention_find_or_create_staging_record(command);
+    if (!record) {
+        std::free(buffer);
+        return false;
+    }
+    if (record->dram_buffer) {
+        std::free(record->dram_buffer);
+    }
+    record->dram_buffer = buffer;
+    llama_solidattention_executor_verify_byte_ranges(*record);
+    llama_solidattention_refresh_executor_staging_counts();
+    return true;
+}
