+static llama_solidattention_kv_staging_record * llama_solidattention_find_or_create_staging_record(
+        const llama_solidattention_kv_command_record & command) {
+    auto * record = llama_solidattention_find_staging_record(command);
+    if (record) {
+        if (record->size_bytes != command.size_bytes) {
+            ++llama_solidattention_kv_bridge_summary.executor_size_mismatch_count;
+            return nullptr;
+        }
+        return record;
+    }
+
+    if (llama_solidattention_kv_staging_record_count >= LLAMA_SOLIDATTENTION_MAX_KV_STAGING_BLOCKS) {
+        ++llama_solidattention_kv_bridge_summary.executor_staging_overflow_count;
+        return nullptr;
+    }
+
+    record = &llama_solidattention_kv_staging_records[llama_solidattention_kv_staging_record_count++];
+    *record = llama_solidattention_kv_staging_record();
+    record->layer_id = command.layer_id;
+    record->block_id = command.block_id;
+    record->start_token = command.start_token;
+    record->end_token = command.end_token;
+    record->size_bytes = command.size_bytes;
