+static void * llama_solidattention_executor_alloc_and_read_backing(
+        const llama_solidattention_kv_command_record & command,
+        bool count_as_ssd_read) {
+    const char * backing_path = std::getenv("LLAMA_SOLIDATTENTION_KV_EXECUTOR_BACKING_PATH");
+    if (command.size_bytes <= 0 || command.ssd_offset < 0) {
+        ++llama_solidattention_kv_bridge_summary.executor_seek_error_count;
+        if (count_as_ssd_read) {
+            ++llama_solidattention_kv_bridge_summary.executor_ssd_read_error_count;
+        }
+        return nullptr;
+    }
+
+    const size_t size = (size_t) command.size_bytes;
+    void * buffer = std::malloc(size);
+    if (!buffer) {
+        ++llama_solidattention_kv_bridge_summary.executor_alloc_error_count;
+        if (count_as_ssd_read) {
+            ++llama_solidattention_kv_bridge_summary.executor_ssd_read_error_count;
+        }
+        return nullptr;
+    }
+
+    const char * backend = llama_solidattention_kv_executor_backend_name();
+    bool ok = false;
+#if defined(LLAMA_SOLIDATTENTION_HAVE_LIBURING)
+    if (std::strcmp(backend, "liburing_backing_file_stub") == 0) {
+        ok = llama_solidattention_executor_read_liburing(backing_path, command, buffer, size);
+    } else
+#endif
+    {
+        ok = llama_solidattention_executor_read_stdio(backing_path, command, buffer, size);
+    }
+
+    if (!ok) {
+        std::free(buffer);
+        if (count_as_ssd_read) {
+            ++llama_solidattention_kv_bridge_summary.executor_ssd_read_error_count;
+        }
+        return nullptr;
+    }
+    return buffer;
+}
