+static void llama_solidattention_kv_trace_event(
+        const char * op,
+        const char * event,
+             int32_t layer_id,
+            uint32_t block_id,
+             int64_t start_token,
+             int64_t end_token,
+              size_t size_bytes,
+          const char * location,
+          const char * source,
+          const char * target,
+             int64_t ssd_offset,
+            uint32_t cache_size,
+            uint32_t n_tokens,
+            uint32_t n_stream) {
+    const char * path = std::getenv("LLAMA_SOLIDATTENTION_KV_TRACE_PATH");
+    if (!path || path[0] == '\0') {
+        return;
+    }
+
+    FILE * fp = std::fopen(path, "a");
+    if (!fp) {
+        return;
+    }
+
+    std::fprintf(fp,
+            "{\"op\":\"%s\",\"layer_id\":%d,\"block_id\":%u,"
+            "\"start_token\":%lld,\"end_token\":%lld,\"size_bytes\":%zu,"
+            "\"location\":\"%s\",\"source\":\"%s\",\"target\":\"%s\","
+            "\"ssd_offset\":%lld,\"metadata\":{\"source\":\"llama.cpp\","
+            "\"event\":\"%s\",\"cache_size\":%u,"
+            "\"n_tokens\":%u,\"n_stream\":%u}}\n",
+            op,
+            layer_id,
+            block_id,
+            (long long) start_token,
+            (long long) end_token,
+            size_bytes,
+            location ? location : "",
+            source ? source : "",
+            target ? target : "",
+            (long long) ssd_offset,
+            event,
+            cache_size,
+            n_tokens,
+            n_stream);
+
+    std::fclose(fp);
+}
