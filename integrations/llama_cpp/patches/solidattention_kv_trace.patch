+static void llama_solidattention_execute_movement_intent_stub(
+        const llama_solidattention_kv_command_record & command,
+        const char * intent_kind) {
+    if (!llama_solidattention_kv_executor_enabled()) {
+        return;
+    }
+
+    llama_solidattention_kv_bridge_summary.executor_enabled = 1;
+    if (!intent_kind) {
+        ++llama_solidattention_kv_bridge_summary.executor_metadata_only_count;
+    } else if (std::strcmp(intent_kind, "ssd_read") == 0) {
+        llama_solidattention_execute_ssd_read_intent(command);
+    } else if (std::strcmp(intent_kind, "dram_to_vram") == 0) {
+        llama_solidattention_execute_dram_to_vram_intent(command);
+    } else if (std::strcmp(intent_kind, "compute") == 0) {
+        llama_solidattention_execute_compute_intent(command);
+    } else if (std::strcmp(intent_kind, "ssd_write") == 0) {
+        llama_solidattention_execute_evict_intent(command);
+    } else {
+        ++llama_solidattention_kv_bridge_summary.executor_metadata_only_count;
+    }
+    llama_solidattention_refresh_executor_staging_counts();
+}
