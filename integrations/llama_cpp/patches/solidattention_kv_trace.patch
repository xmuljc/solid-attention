+static uint64_t llama_solidattention_fnv1a_update(
+        uint64_t hash,
+        const void * data,
+        size_t size) {
+    const unsigned char * bytes = static_cast<const unsigned char *>(data);
+    for (size_t i = 0; i < size; ++i) {
+        hash ^= (uint64_t) bytes[i];
+        hash *= 1099511628211ull;
+    }
+    return hash;
+}
+
+static uint64_t llama_solidattention_staging_checksum(
+        const llama_solidattention_kv_staging_record & record,
+        bool value_rows_only) {
+    const uint64_t fnv_offset = 1469598103934665603ull;
+    uint64_t hash = fnv_offset;
+    if (!record.vram_buffer || record.key_row_size_bytes == 0 || record.value_row_size_bytes == 0) {
+        return hash;
+    }
+
+    const int64_t token_count = record.end_token - record.start_token;
+    if (token_count <= 0) {
+        return hash;
+    }
+
+    const unsigned char * bytes = static_cast<const unsigned char *>(record.vram_buffer);
+    const uint64_t stride = record.key_row_size_bytes + record.value_row_size_bytes;
+    const uint64_t row_size = value_rows_only ? record.value_row_size_bytes : record.key_row_size_bytes;
+    const uint64_t row_offset = value_rows_only ? record.key_row_size_bytes : 0;
+    for (int64_t token_index = 0; token_index < token_count; ++token_index) {
+        const uint64_t staging_offset = (uint64_t) token_index * stride + row_offset;
+        hash = llama_solidattention_fnv1a_update(hash, bytes + staging_offset, (size_t) row_size);
+    }
+    return hash;
+}
