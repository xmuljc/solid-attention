+#if defined(LLAMA_SOLIDATTENTION_HAVE_LIBURING)
+static bool llama_solidattention_executor_read_liburing(
+        const char * backing_path,
+        const llama_solidattention_kv_command_record & command,
+        void * buffer,
+        size_t size) {
+    int fd = open(backing_path, O_RDONLY);
+    if (fd < 0) {
+        ++llama_solidattention_kv_bridge_summary.executor_open_error_count;
+        return false;
+    }
+
+    struct io_uring ring;
+    if (io_uring_queue_init(8, &ring, 0) != 0) {
+        ++llama_solidattention_kv_bridge_summary.executor_backend_error_count;
+        close(fd);
+        return false;
+    }
+
+    struct io_uring_sqe * sqe = io_uring_get_sqe(&ring);
+    if (!sqe) {
+        ++llama_solidattention_kv_bridge_summary.executor_backend_error_count;
+        io_uring_queue_exit(&ring);
+        close(fd);
+        return false;
+    }
+
+    io_uring_prep_read(sqe, fd, buffer, size, (off_t) command.ssd_offset);
+    if (io_uring_submit(&ring) < 0) {
+        ++llama_solidattention_kv_bridge_summary.executor_backend_error_count;
+        io_uring_queue_exit(&ring);
+        close(fd);
+        return false;
+    }
+
+    struct io_uring_cqe * cqe = nullptr;
+    const int wait_rc = io_uring_wait_cqe(&ring, &cqe);
+    bool ok = false;
+    if (wait_rc == 0 && cqe) {
+        ok = cqe->res == (int) size;
+        if (!ok) {
+            ++llama_solidattention_kv_bridge_summary.executor_short_read_count;
+        }
+        io_uring_cqe_seen(&ring, cqe);
+    } else {
+        ++llama_solidattention_kv_bridge_summary.executor_backend_error_count;
+    }
+
+    io_uring_queue_exit(&ring);
+    close(fd);
+    return ok;
+}
+#endif
