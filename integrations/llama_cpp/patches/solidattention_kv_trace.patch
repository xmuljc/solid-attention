+static const char * llama_solidattention_skip_json_ws(const char * pos) {
+    while (*pos == ' ' || *pos == '\t') {
+        ++pos;
+    }
+    return pos;
+}
+
+static const char * llama_solidattention_json_field(const char * line, const char * key) {
+    char pattern[96];
+    std::snprintf(pattern, sizeof(pattern), "\"%s\"", key);
+
+    const char * pos = std::strstr(line, pattern);
+    if (!pos) {
+        return nullptr;
+    }
+
+    pos += std::strlen(pattern);
+    pos = llama_solidattention_skip_json_ws(pos);
+    if (*pos != ':') {
+        return nullptr;
+    }
+
+    return llama_solidattention_skip_json_ws(pos + 1);
+}
+
+static bool llama_solidattention_json_string(const char * line, const char * key, char * out, size_t out_size) {
+    if (out_size == 0) {
+        return false;
+    }
+
+    const char * pos = llama_solidattention_json_field(line, key);
+    if (!pos || *pos != '\"') {
+        return false;
+    }
+
+    ++pos;
+    size_t n = 0;
+    while (*pos && *pos != '\"') {
+        if (*pos == '\\' || n + 1 >= out_size) {
+            return false;
+        }
+        out[n++] = *pos++;
+    }
+
+    if (*pos != '\"') {
+        return false;
+    }
+
+    out[n] = '\0';
+    return true;
+}
+
+static bool llama_solidattention_json_i64(const char * line, const char * key, int64_t * out) {
+    const char * pos = llama_solidattention_json_field(line, key);
+    if (!pos) {
+        return false;
+    }
+
+    char * end = nullptr;
+    const long long value = std::strtoll(pos, &end, 10);
+    if (end == pos) {
+        return false;
+    }
+
+    *out = (int64_t) value;
+    return true;
+}
+
+static bool llama_solidattention_json_bool(const char * line, const char * key, bool * out) {
+    const char * pos = llama_solidattention_json_field(line, key);
+    if (!pos) {
+        return false;
+    }
+
+    if (std::strncmp(pos, "true", 4) == 0) {
+        *out = true;
+        return true;
+    }
+
+    if (std::strncmp(pos, "false", 5) == 0) {
+        *out = false;
+        return true;
+    }
+
+    return false;
+}
+
+static bool llama_solidattention_has_layer_id(const std::vector<uint32_t> & layer_ids, int64_t layer_id) {
+    if (layer_id < 0) {
+        return false;
+    }
+
+    for (uint32_t candidate : layer_ids) {
+        if ((uint32_t) layer_id == candidate) {
+            return true;
+        }
+    }
+
+    return false;
+}
+
+static bool llama_solidattention_is_location(const char * value) {
+    return std::strcmp(value, "ssd") == 0 || std::strcmp(value, "dram") == 0 || std::strcmp(value, "vram") == 0;
+}
+
+static bool llama_solidattention_is_command_op(const char * op) {
+    return std::strcmp(op, "kv_load") == 0 ||
+        std::strcmp(op, "kv_prefetch") == 0 ||
+        std::strcmp(op, "kv_compute") == 0 ||
+        std::strcmp(op, "kv_evict") == 0;
+}
+
+static void llama_solidattention_record_command_counts(
+        llama_solidattention_kv_command_summary & summary,
+        const char * op,
+        const char * source,
+        const char * target,
+        int64_t size_bytes) {
+    if (std::strcmp(op, "kv_load") == 0) {
+        ++summary.kv_load_count;
+    } else if (std::strcmp(op, "kv_prefetch") == 0) {
+        ++summary.kv_prefetch_count;
+    } else if (std::strcmp(op, "kv_compute") == 0) {
+        ++summary.kv_compute_count;
+    } else if (std::strcmp(op, "kv_evict") == 0) {
+        ++summary.kv_evict_count;
+    }
+
+    ++summary.valid_command_count;
+
+    if ((std::strcmp(op, "kv_load") == 0 || std::strcmp(op, "kv_prefetch") == 0) && std::strcmp(source, "ssd") == 0) {
+        ++summary.ssd_read_command_count;
+        summary.ssd_read_bytes += (uint64_t) size_bytes;
+    }
+
+    if (std::strcmp(op, "kv_evict") == 0 && std::strcmp(target, "ssd") == 0) {
+        ++summary.ssd_write_command_count;
+        summary.ssd_write_bytes += (uint64_t) size_bytes;
+    }
+}
+
+static void llama_solidattention_store_command_record(
+        const char * op,
+        const char * source,
+        const char * target,
+        int64_t layer_id,
+        int64_t block_id,
+        int64_t start_token,
+        int64_t end_token,
+        int64_t size_bytes,
+        int64_t ssd_offset,
+        bool blocking) {
+    if (llama_solidattention_kv_command_record_count >= LLAMA_SOLIDATTENTION_MAX_KV_COMMANDS) {
+        return;
+    }
+
+    auto & record = llama_solidattention_kv_command_records[llama_solidattention_kv_command_record_count++];
+    std::snprintf(record.op, sizeof(record.op), "%s", op);
+    std::snprintf(record.source, sizeof(record.source), "%s", source);
+    std::snprintf(record.target, sizeof(record.target), "%s", target);
+    record.layer_id = layer_id;
+    record.block_id = block_id;
+    record.start_token = start_token;
+    record.end_token = end_token;
+    record.size_bytes = size_bytes;
+    record.ssd_offset = ssd_offset;
+    record.blocking = blocking;
+}
