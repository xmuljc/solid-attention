+static void llama_solidattention_execute_dram_to_vram_intent(
+        const llama_solidattention_kv_command_record & command) {
+    auto * record = llama_solidattention_executor_ensure_dram_source(command);
+    if (!record || !record->dram_buffer) {
+        return;
+    }
+    if (record->size_bytes != command.size_bytes) {
+        ++llama_solidattention_kv_bridge_summary.executor_size_mismatch_count;
+        return;
+    }
+    void * buffer = std::malloc((size_t) command.size_bytes);
+    if (!buffer) {
+        ++llama_solidattention_kv_bridge_summary.executor_alloc_error_count;
+        return;
+    }
+    std::memcpy(buffer, record->dram_buffer, (size_t) command.size_bytes);
+    if (llama_solidattention_executor_assign_vram_buffer(command, buffer)) {
+        ++llama_solidattention_kv_bridge_summary.executor_dram_to_vram_copy_count;
+        llama_solidattention_kv_bridge_summary.executor_dram_to_vram_copy_bytes += (uint64_t) command.size_bytes;
+    }
+}
