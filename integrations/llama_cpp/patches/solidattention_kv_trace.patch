+static bool llama_solidattention_attention_command_requires_residency(
+        const llama_solidattention_kv_command_record & command) {
+    return std::strcmp(command.op, "kv_compute") == 0 || std::strcmp(command.target, "vram") == 0;
+}
+
+static bool llama_solidattention_attention_command_overlaps_view(
+        const llama_solidattention_kv_command_record & command,
+        int32_t layer_id,
+        uint32_t n_kv) {
+    if (command.layer_id != layer_id || !llama_solidattention_attention_command_requires_residency(command)) {
+        return false;
+    }
+    const int64_t token_count = command.end_token - command.start_token;
+    if (command.block_id < 0 || token_count <= 0) {
+        return false;
+    }
+    const uint64_t cell_start = (uint64_t) command.block_id;
+    const uint64_t cell_end = cell_start + (uint64_t) token_count;
+    return cell_start < (uint64_t) n_kv && cell_end > 0;
+}
+
+static bool llama_solidattention_attention_command_key_seen(
+        uint32_t upto,
+        const llama_solidattention_kv_command_record & command,
+        int32_t layer_id,
+        uint32_t n_kv) {
+    for (uint32_t i = 0; i < upto; ++i) {
+        const auto & previous = llama_solidattention_kv_command_records[i];
+        if (!llama_solidattention_attention_command_overlaps_view(previous, layer_id, n_kv)) {
+            continue;
+        }
+        if (previous.layer_id == command.layer_id &&
+                previous.block_id == command.block_id &&
+                previous.start_token == command.start_token &&
+                previous.end_token == command.end_token) {
+            return true;
+        }
+    }
+    return false;
 }
 
+static llama_solidattention_kv_staging_record * llama_solidattention_find_staging_record_by_key(
+        int64_t layer_id,
+        int64_t block_id,
+        int64_t start_token,
+        int64_t end_token) {
+    for (uint32_t i = 0; i < llama_solidattention_kv_staging_record_count; ++i) {
+        auto & record = llama_solidattention_kv_staging_records[i];
+        if (record.layer_id == layer_id &&
+                record.block_id == block_id &&
+                record.start_token == start_token &&
+                record.end_token == end_token) {
+            return &record;
+        }
+    }
+    return nullptr;
+}
