+            "\"value_tensor_start_offset\":%llu,\"value_tensor_end_offset\":%llu,"
+            "\"staging_key_checksum_fnv1a64\":\"%016llx\","
+            "\"staging_value_checksum_fnv1a64\":\"%016llx\","
+            "\"post_key_checksum_fnv1a64\":\"%016llx\","
+            "\"post_value_checksum_fnv1a64\":\"%016llx\","
+            "\"cache_size\":%u,\"tensor_bounds_error_count\":%u}}\n",
+            (long long) record.layer_id,
+            (long long) record.block_id,
+            (long long) record.start_token,
+            (long long) record.end_token,
+            (long long) record.size_bytes,
+            status ? status : "unknown",
+            (unsigned long long) cell_start,
+            (unsigned long long) cell_end,
+            (unsigned long long) ((uint64_t) std::max<int64_t>(0, token_count) * 2),
+            (unsigned long long) record.key_row_size_bytes,
+            (unsigned long long) record.value_row_size_bytes,
+            (unsigned long long) key_tensor_start_offset,
+            (unsigned long long) key_tensor_end_offset,
+            (unsigned long long) value_tensor_start_offset,
+            (unsigned long long) value_tensor_end_offset,
+            (unsigned long long) staging_key_checksum,
+            (unsigned long long) staging_value_checksum,
+            (unsigned long long) post_key_checksum,
+            (unsigned long long) post_value_checksum,
+            llama_solidattention_kv_bridge_summary.cache_size,
+            tensor_bounds_error_count);
+
+    std::fclose(fp);
+}
+
+static void llama_solidattention_executor_tensor_mutation_gate(
+        llama_solidattention_kv_staging_record & record,
+        ggml_tensor * k_tensor,
+        ggml_tensor * v_tensor,
+        bool v_trans) {
+    if (!llama_solidattention_kv_tensor_mutation_enabled()) {
+        return;
+    }
+
+    llama_solidattention_kv_bridge_summary.executor_tensor_mutation_enabled = 1;
+    if (!record.vram_buffer) {
+        return;
+    }
+    if (record.tensor_mutation_checked) {
+        return;
+    }
+    record.tensor_mutation_checked = true;
+    ++llama_solidattention_kv_bridge_summary.executor_tensor_mutation_attempt_count;
+
+    if (!k_tensor || !v_tensor || k_tensor->ne[2] != 1 || v_tensor->ne[2] != 1) {
+        ++llama_solidattention_kv_bridge_summary.executor_tensor_mutation_unsupported_count;
+        llama_solidattention_write_tensor_mutation_event(record, "unsupported", 0, 0, 0, 0, 0);
+        return;
+    }
+
+    llama_solidattention_executor_verify_byte_ranges(record);
+    const int64_t token_count = record.end_token - record.start_token;
+    if (token_count <= 0 || record.size_bytes <= 0 || record.key_row_size_bytes == 0 || record.value_row_size_bytes == 0) {
+        ++llama_solidattention_kv_bridge_summary.executor_tensor_mutation_size_mismatch_count;
+        llama_solidattention_write_tensor_mutation_event(record, "size_mismatch", 0, 0, 0, 0, 0);
+        return;
+    }
+
+    const uint64_t expected_size = (uint64_t) token_count * (record.key_row_size_bytes + record.value_row_size_bytes);
+    const uint64_t cell_start = (uint64_t) record.block_id;
+    const uint64_t cell_end = cell_start + (uint64_t) token_count;
+    const uint32_t cache_size = llama_solidattention_kv_bridge_summary.cache_size;
+    if (expected_size != (uint64_t) record.size_bytes) {
+        ++llama_solidattention_kv_bridge_summary.executor_tensor_mutation_size_mismatch_count;
+        llama_solidattention_write_tensor_mutation_event(record, "size_mismatch", 0, 0, 0, 0, 0);
+        return;
+    }
+    if (cache_size > 0 && cell_end > (uint64_t) cache_size) {
+        const uint64_t first_oob_cell = std::max<uint64_t>(cell_start, (uint64_t) cache_size);
+        const uint64_t oob_cells = cell_end - first_oob_cell;
+        const uint32_t errors = (uint32_t) oob_cells * 2;
+        llama_solidattention_kv_bridge_summary.executor_tensor_mutation_tensor_bounds_error_count += errors;
+        llama_solidattention_write_tensor_mutation_event(record, "tensor_bounds_error", 0, 0, 0, 0, errors);
+        return;
+    }
+
+    const size_t k_row_size = ggml_row_size(k_tensor->type, k_tensor->ne[0]);
+    if (k_row_size != (size_t) record.key_row_size_bytes) {
+        ++llama_solidattention_kv_bridge_summary.executor_tensor_mutation_size_mismatch_count;
+        llama_solidattention_write_tensor_mutation_event(record, "size_mismatch", 0, 0, 0, 0, 0);
+        return;
+    }
+
+    bool v_trans_supported = true;
+    size_t v_row_size = 0;
+    size_t v_el_size = 0;
+    if (!v_trans) {
+        v_row_size = ggml_row_size(v_tensor->type, v_tensor->ne[0]);
+        if (v_row_size != (size_t) record.value_row_size_bytes) {
+            ++llama_solidattention_kv_bridge_summary.executor_tensor_mutation_size_mismatch_count;
+            llama_solidattention_write_tensor_mutation_event(record, "size_mismatch", 0, 0, 0, 0, 0);
+            return;
+        }
+    } else {
+        v_el_size = ggml_type_size(v_tensor->type);
+        v_row_size = (size_t) v_tensor->ne[0] * v_el_size;
+        v_trans_supported = ggml_blck_size(v_tensor->type) == 1 && v_row_size == (size_t) record.value_row_size_bytes;
+        if (!v_trans_supported) {
+            ++llama_solidattention_kv_bridge_summary.executor_tensor_mutation_unsupported_count;
+            llama_solidattention_write_tensor_mutation_event(record, "unsupported", 0, 0, 0, 0, 0);
+            return;
+        }
+    }
+
+    const unsigned char * bytes = static_cast<const unsigned char *>(record.vram_buffer);
+    const uint64_t stride = record.key_row_size_bytes + record.value_row_size_bytes;
+    const uint64_t staging_key_checksum = llama_solidattention_staging_checksum(record, false);
+    const uint64_t staging_value_checksum = llama_solidattention_staging_checksum(record, true);
+    uint64_t post_key_checksum = 1469598103934665603ull;
+    uint64_t post_value_checksum = 1469598103934665603ull;
+
+    for (int64_t token_index = 0; token_index < token_count; ++token_index) {
+        const uint64_t cell = cell_start + (uint64_t) token_index;
+        const uint64_t key_staging_offset = (uint64_t) token_index * stride;
+        const uint64_t value_staging_offset = key_staging_offset + record.key_row_size_bytes;
+        const size_t key_tensor_offset = (size_t) cell * k_row_size;
+        ggml_backend_tensor_set(k_tensor, bytes + key_staging_offset, key_tensor_offset, k_row_size);
+        std::vector<unsigned char> key_row(k_row_size);
+        ggml_backend_tensor_get(k_tensor, key_row.data(), key_tensor_offset, key_row.size());
+        post_key_checksum = llama_solidattention_fnv1a_update(post_key_checksum, key_row.data(), key_row.size());
+
+        if (!v_trans) {
+            const size_t value_tensor_offset = (size_t) cell * v_row_size;
+            ggml_backend_tensor_set(v_tensor, bytes + value_staging_offset, value_tensor_offset, v_row_size);
+            std::vector<unsigned char> value_row(v_row_size);
+            ggml_backend_tensor_get(v_tensor, value_row.data(), value_tensor_offset, value_row.size());
+            post_value_checksum = llama_solidattention_fnv1a_update(post_value_checksum, value_row.data(), value_row.size());
+        } else {
+            for (int64_t j = 0; j < v_tensor->ne[0]; ++j) {
+                const size_t src_offset = (size_t) value_staging_offset + (size_t) j * v_el_size;
+                const size_t dst_offset = ((size_t) cell + (size_t) j * (size_t) cache_size) * v_el_size;
+                ggml_backend_tensor_set(v_tensor, bytes + src_offset, dst_offset, v_el_size);
+                std::vector<unsigned char> value_el(v_el_size);
+                ggml_backend_tensor_get(v_tensor, value_el.data(), dst_offset, value_el.size());
+                post_value_checksum = llama_solidattention_fnv1a_update(post_value_checksum, value_el.data(), value_el.size());
+            }
+        }
+    }
+
+    ++llama_solidattention_kv_bridge_summary.executor_tensor_mutation_block_count;
+    llama_solidattention_kv_bridge_summary.executor_tensor_mutation_range_count += (uint32_t) token_count * 2;
+    llama_solidattention_kv_bridge_summary.executor_tensor_mutation_bytes += (uint64_t) record.size_bytes;
+    llama_solidattention_kv_bridge_summary.executor_tensor_mutation_key_bytes += (uint64_t) token_count * record.key_row_size_bytes;
+    llama_solidattention_kv_bridge_summary.executor_tensor_mutation_value_bytes += (uint64_t) token_count * record.value_row_size_bytes;
+    llama_solidattention_kv_bridge_summary.executor_tensor_mutation_checksum_count += 4;
+    llama_solidattention_kv_bridge_summary.executor_tensor_mutation_staging_checksum_xor ^= staging_key_checksum ^ staging_value_checksum;
+    llama_solidattention_kv_bridge_summary.executor_tensor_mutation_post_checksum_xor ^= post_key_checksum ^ post_value_checksum;
+
+    uint32_t verify_errors = 0;
+    if (staging_key_checksum != post_key_checksum) {
+        ++verify_errors;
+    }
+    if (staging_value_checksum != post_value_checksum) {
+        ++verify_errors;
+    }
+    llama_solidattention_kv_bridge_summary.executor_tensor_mutation_verify_error_count += verify_errors;
+
+    llama_solidattention_write_tensor_mutation_event(
+            record,
+            verify_errors == 0 ? "ok" : "verify_error",
+            staging_key_checksum,
+            staging_value_checksum,
+            post_key_checksum,
+            post_value_checksum,
+            0);
+}
+
+static void llama_solidattention_refresh_executor_staging_counts() {
+    llama_solidattention_kv_bridge_summary.executor_staging_record_count = llama_solidattention_kv_staging_record_count;
+    llama_solidattention_kv_bridge_summary.executor_dram_buffer_count = 0;
+    llama_solidattention_kv_bridge_summary.executor_dram_buffer_bytes = 0;
+    llama_solidattention_kv_bridge_summary.executor_vram_buffer_count = 0;
+    llama_solidattention_kv_bridge_summary.executor_vram_buffer_bytes = 0;
+
+    for (uint32_t i = 0; i < llama_solidattention_kv_staging_record_count; ++i) {
+        const auto & record = llama_solidattention_kv_staging_records[i];
+        if (record.dram_buffer) {
+            ++llama_solidattention_kv_bridge_summary.executor_dram_buffer_count;
+            llama_solidattention_kv_bridge_summary.executor_dram_buffer_bytes += (uint64_t) record.size_bytes;
+        }
+        if (record.vram_buffer) {
+            ++llama_solidattention_kv_bridge_summary.executor_vram_buffer_count;
+            llama_solidattention_kv_bridge_summary.executor_vram_buffer_bytes += (uint64_t) record.size_bytes;
+        }
+    }
+}
+
+static void llama_solidattention_free_executor_staging_records() {
+    for (uint32_t i = 0; i < llama_solidattention_kv_staging_record_count; ++i) {
+        auto & record = llama_solidattention_kv_staging_records[i];
+        if (record.dram_buffer) {
+            std::free(record.dram_buffer);
+        }
+        if (record.vram_buffer) {
+            std::free(record.vram_buffer);
+        }
+        record = llama_solidattention_kv_staging_record();
+    }
+    llama_solidattention_kv_staging_record_count = 0;
+    llama_solidattention_refresh_executor_staging_counts();
+}
