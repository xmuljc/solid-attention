+static void llama_solidattention_execute_evict_intent(
+        const llama_solidattention_kv_command_record & command) {
+    auto * record = llama_solidattention_find_staging_record(command);
+    if (!record || (!record->vram_buffer && !record->dram_buffer)) {
+        ++llama_solidattention_kv_bridge_summary.executor_missing_source_count;
+        return;
+    }
+    if (record->vram_buffer) {
+        std::free(record->vram_buffer);
+        record->vram_buffer = nullptr;
+    } else if (record->dram_buffer) {
+        std::free(record->dram_buffer);
+        record->dram_buffer = nullptr;
+    }
+    ++llama_solidattention_kv_bridge_summary.executor_evict_count;
+    llama_solidattention_kv_bridge_summary.executor_evict_bytes += (uint64_t) command.size_bytes;
+    llama_solidattention_refresh_executor_staging_counts();
+}
