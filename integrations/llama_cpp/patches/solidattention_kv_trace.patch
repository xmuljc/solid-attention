+static void llama_solidattention_write_tensor_dry_run_event(
+        const llama_solidattention_kv_staging_record & record,
+        uint64_t block_checksum,
+        uint64_t key_checksum,
+        uint64_t value_checksum,
+        uint32_t tensor_bounds_error_count) {
+    const char * path = std::getenv("LLAMA_SOLIDATTENTION_KV_TENSOR_DRY_RUN_TRACE_PATH");
+    if (!path || path[0] == '\0') {
+        return;
+    }
+
+    FILE * fp = std::fopen(path, "a");
+    if (!fp) {
+        return;
+    }
+
+    const int64_t token_count = record.end_token - record.start_token;
+    const uint64_t stride = record.key_row_size_bytes + record.value_row_size_bytes;
+    const uint64_t range_count = (uint64_t) token_count * 2;
+    const uint64_t cell_start = (uint64_t) record.block_id;
+    const uint64_t cell_end = cell_start + (uint64_t) std::max<int64_t>(0, token_count);
+    const uint64_t key_tensor_start_offset = cell_start * record.key_row_size_bytes;
+    const uint64_t key_tensor_end_offset = cell_end * record.key_row_size_bytes;
+    const uint64_t value_tensor_start_offset = cell_start * record.value_row_size_bytes;
+    const uint64_t value_tensor_end_offset = cell_end * record.value_row_size_bytes;
+    const uint64_t last_key_staging_offset = token_count > 0 ? (uint64_t) (token_count - 1) * stride : 0;
+    const uint64_t last_value_staging_offset = last_key_staging_offset + record.key_row_size_bytes;
+
+    std::fprintf(fp,
+            "{\"op\":\"kv_tensor_copy_dry_run\",\"layer_id\":%lld,\"block_id\":%lld,"
+            "\"start_token\":%lld,\"end_token\":%lld,\"size_bytes\":%lld,"
+            "\"metadata\":{\"source\":\"llama.cpp\","
+            "\"event\":\"solidattention_kv_tensor_copy_dry_run\","
+            "\"source_buffer\":\"vram_staging\",\"target\":\"llama.cpp_kv_tensors\","
+            "\"interleaved_layout\":\"k_then_v_per_token\","
+            "\"cell_start\":%llu,\"cell_end\":%llu,"
+            "\"range_count\":%llu,\"staging_stride_bytes\":%llu,"
+            "\"key_row_size_bytes\":%llu,\"value_row_size_bytes\":%llu,"
+            "\"key_tensor_start_offset\":%llu,\"key_tensor_end_offset\":%llu,"
+            "\"value_tensor_start_offset\":%llu,\"value_tensor_end_offset\":%llu,"
+            "\"first_key_staging_offset\":0,\"first_value_staging_offset\":%llu,"
+            "\"last_key_staging_offset\":%llu,\"last_value_staging_offset\":%llu,"
+            "\"block_checksum_fnv1a64\":\"%016llx\","
+            "\"key_checksum_fnv1a64\":\"%016llx\","
+            "\"value_checksum_fnv1a64\":\"%016llx\","
+            "\"cache_size\":%u,\"tensor_bounds_error_count\":%u}}\n",
+            (long long) record.layer_id,
+            (long long) record.block_id,
+            (long long) record.start_token,
+            (long long) record.end_token,
+            (long long) record.size_bytes,
+            (unsigned long long) cell_start,
+            (unsigned long long) cell_end,
+            (unsigned long long) range_count,
+            (unsigned long long) stride,
+            (unsigned long long) record.key_row_size_bytes,
+            (unsigned long long) record.value_row_size_bytes,
+            (unsigned long long) key_tensor_start_offset,
+            (unsigned long long) key_tensor_end_offset,
+            (unsigned long long) value_tensor_start_offset,
+            (unsigned long long) value_tensor_end_offset,
+            (unsigned long long) record.key_row_size_bytes,
+            (unsigned long long) last_key_staging_offset,
+            (unsigned long long) last_value_staging_offset,
+            (unsigned long long) block_checksum,
+            (unsigned long long) key_checksum,
+            (unsigned long long) value_checksum,
+            llama_solidattention_kv_bridge_summary.cache_size,
+            tensor_bounds_error_count);
+
+    std::fclose(fp);
+}
