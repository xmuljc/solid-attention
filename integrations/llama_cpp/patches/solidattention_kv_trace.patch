+static void llama_solidattention_write_attention_gate_event(
+        const char * view,
+        int32_t layer_id,
+        uint32_t n_kv,
+        uint32_t n_stream,
+        uint32_t required_block_count,
+        uint32_t ready_block_count,
+        uint32_t missing_block_count,
+        uint32_t pending_mutation_count) {
+    const char * path = std::getenv("LLAMA_SOLIDATTENTION_KV_ATTENTION_GATE_TRACE_PATH");
+    if (!path || path[0] == '\0') {
+        return;
+    }
+
+    FILE * fp = std::fopen(path, "a");
+    if (!fp) {
+        return;
+    }
+
+    const char * status = "ok";
+    if (required_block_count == 0) {
+        status = "no_required_blocks";
+    } else if (missing_block_count > 0) {
+        status = "missing_staging";
+    } else if (pending_mutation_count > 0) {
+        status = "pending_mutation";
+    }
+
+    std::fprintf(fp,
+            "{\"op\":\"kv_attention_residency_gate\",\"layer_id\":%lld,\"block_id\":-1,"
+            "\"start_token\":0,\"end_token\":%u,\"size_bytes\":0,"
+            "\"metadata\":{\"source\":\"llama.cpp\","
+            "\"event\":\"solidattention_attention_residency_gate\","
+            "\"view\":\"%s\",\"status\":\"%s\",\"n_kv\":%u,\"n_stream\":%u,"
+            "\"required_block_count\":%u,\"ready_block_count\":%u,"
+            "\"missing_block_count\":%u,\"pending_mutation_count\":%u}}\n",
+            (long long) layer_id,
+            n_kv,
+            view ? view : "unknown",
+            status,
+            n_kv,
+            n_stream,
+            required_block_count,
+            ready_block_count,
+            missing_block_count,
+            pending_mutation_count);
+
+    std::fclose(fp);
+}
