+static uint64_t llama_solidattention_tensor_row_checksum(
+        const ggml_tensor * tensor,
+        size_t offset,
+        size_t size) {
+    std::vector<unsigned char> row(size);
+    ggml_backend_tensor_get(tensor, row.data(), offset, size);
+    return llama_solidattention_fnv1a_update(1469598103934665603ull, row.data(), row.size());
+}
