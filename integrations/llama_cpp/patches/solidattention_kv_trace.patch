+static bool llama_solidattention_executor_read_stdio(
+        const char * backing_path,
+        const llama_solidattention_kv_command_record & command,
+        void * buffer,
+        size_t size) {
+    FILE * fp = std::fopen(backing_path, "rb");
+    if (!fp) {
+        ++llama_solidattention_kv_bridge_summary.executor_open_error_count;
+        return false;
+    }
+
+    if (command.ssd_offset > (int64_t) std::numeric_limits<long>::max()) {
+        ++llama_solidattention_kv_bridge_summary.executor_seek_error_count;
+        std::fclose(fp);
+        return false;
+    }
+
+    if (std::fseek(fp, (long) command.ssd_offset, SEEK_SET) != 0) {
+        ++llama_solidattention_kv_bridge_summary.executor_seek_error_count;
+        std::fclose(fp);
+        return false;
+    }
+
+    const size_t n_read = std::fread(buffer, 1, size, fp);
+    std::fclose(fp);
+    if (n_read != size) {
+        ++llama_solidattention_kv_bridge_summary.executor_short_read_count;
+        return false;
+    }
+    return true;
+}
