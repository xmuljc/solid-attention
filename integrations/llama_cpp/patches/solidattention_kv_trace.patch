+    if (record->size_bytes != command.size_bytes) {
+        ++llama_solidattention_kv_bridge_summary.executor_size_mismatch_count;
+        return;
+    }
+    ++llama_solidattention_kv_bridge_summary.executor_compute_resident_count;
