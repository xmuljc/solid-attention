+static void llama_solidattention_executor_verify_byte_ranges(
+        llama_solidattention_kv_staging_record & record) {
+    if (record.byte_range_checked) {
+        return;
+    }
+    record.byte_range_checked = true;
+
+    const int64_t token_count = record.end_token - record.start_token;
+    if (token_count <= 0 || record.size_bytes <= 0 || record.size_bytes % token_count != 0) {
+        ++llama_solidattention_kv_bridge_summary.executor_byte_range_size_mismatch_count;
+        return;
+    }
+
+    const int64_t per_token_bytes = record.size_bytes / token_count;
+    if (per_token_bytes <= 0 || per_token_bytes % 2 != 0) {
+        ++llama_solidattention_kv_bridge_summary.executor_byte_range_size_mismatch_count;
+        return;
+    }
+
+    record.key_row_size_bytes = (uint64_t) per_token_bytes / 2;
+    record.value_row_size_bytes = (uint64_t) per_token_bytes / 2;
+    ++llama_solidattention_kv_bridge_summary.executor_byte_range_block_count;
+    llama_solidattention_kv_bridge_summary.executor_byte_range_count += (uint32_t) token_count * 2;
+    llama_solidattention_kv_bridge_summary.executor_byte_range_mapped_bytes += (uint64_t) record.size_bytes;
+    llama_solidattention_kv_bridge_summary.executor_byte_range_key_bytes += (uint64_t) token_count * record.key_row_size_bytes;
+    llama_solidattention_kv_bridge_summary.executor_byte_range_value_bytes += (uint64_t) token_count * record.value_row_size_bytes;
+    ++llama_solidattention_kv_bridge_summary.executor_byte_range_inferred_row_size_count;
+
+    const uint32_t cache_size = llama_solidattention_kv_bridge_summary.cache_size;
+    if (cache_size > 0 && record.end_token > (int64_t) cache_size) {
+        const int64_t first_oob_token = std::max<int64_t>(record.start_token, (int64_t) cache_size);
+        const int64_t oob_tokens = record.end_token - first_oob_token;
+        if (oob_tokens > 0) {
+            llama_solidattention_kv_bridge_summary.executor_byte_range_tensor_bounds_error_count += (uint32_t) oob_tokens * 2;
+        }
+    }
+}
