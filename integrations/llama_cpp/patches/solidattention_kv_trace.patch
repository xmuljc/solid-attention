+static llama_solidattention_kv_shadow_record * llama_solidattention_find_or_create_shadow_record(
+        int64_t layer_id,
+        int64_t block_id,
+        int64_t start_token,
+        int64_t end_token,
+        const char * initial_location) {
+    for (uint32_t i = 0; i < llama_solidattention_kv_shadow_record_count; ++i) {
+        auto & record = llama_solidattention_kv_shadow_records[i];
+        if (record.layer_id == layer_id &&
+                record.block_id == block_id &&
+                record.start_token == start_token &&
+                record.end_token == end_token) {
+            return &record;
+        }
+    }
+
+    if (llama_solidattention_kv_shadow_record_count >= LLAMA_SOLIDATTENTION_MAX_KV_SHADOW_BLOCKS) {
+        return nullptr;
+    }
+
+    auto & record = llama_solidattention_kv_shadow_records[llama_solidattention_kv_shadow_record_count++];
+    record.layer_id = layer_id;
+    record.block_id = block_id;
+    record.start_token = start_token;
+    record.end_token = end_token;
