+static void llama_solidattention_executor_tensor_copy_dry_run(
+        llama_solidattention_kv_staging_record & record) {
+    if (!llama_solidattention_kv_tensor_dry_run_enabled()) {
+        return;
+    }
+
+    llama_solidattention_kv_bridge_summary.executor_tensor_dry_run_enabled = 1;
+    if (record.tensor_dry_run_checked) {
+        return;
+    }
+    record.tensor_dry_run_checked = true;
+
+    if (!record.vram_buffer) {
+        return;
+    }
+
+    llama_solidattention_executor_verify_byte_ranges(record);
+    const int64_t token_count = record.end_token - record.start_token;
+    if (token_count <= 0 || record.size_bytes <= 0 || record.key_row_size_bytes == 0 || record.value_row_size_bytes == 0) {
+        ++llama_solidattention_kv_bridge_summary.executor_tensor_dry_run_size_mismatch_count;
+        return;
+    }
+
+    const uint64_t expected_size = (uint64_t) token_count * (record.key_row_size_bytes + record.value_row_size_bytes);
+    if (expected_size != (uint64_t) record.size_bytes) {
+        ++llama_solidattention_kv_bridge_summary.executor_tensor_dry_run_size_mismatch_count;
+        return;
+    }
+
+    uint32_t tensor_bounds_error_count = 0;
+    const uint32_t cache_size = llama_solidattention_kv_bridge_summary.cache_size;
+    if (cache_size > 0 && record.end_token > (int64_t) cache_size) {
+        const int64_t first_oob_token = std::max<int64_t>(record.start_token, (int64_t) cache_size);
+        const int64_t oob_tokens = record.end_token - first_oob_token;
+        if (oob_tokens > 0) {
+            tensor_bounds_error_count = (uint32_t) oob_tokens * 2;
+        }
+    }
+
+    const uint64_t block_checksum = llama_solidattention_fnv1a_update(
+            1469598103934665603ull,
+            record.vram_buffer,
+            (size_t) record.size_bytes);
+    const uint64_t key_checksum = llama_solidattention_staging_checksum(record, false);
+    const uint64_t value_checksum = llama_solidattention_staging_checksum(record, true);
+    const uint64_t range_count = (uint64_t) token_count * 2;
+    const uint64_t key_bytes = (uint64_t) token_count * record.key_row_size_bytes;
+    const uint64_t value_bytes = (uint64_t) token_count * record.value_row_size_bytes;
+
+    ++llama_solidattention_kv_bridge_summary.executor_tensor_dry_run_block_count;
+    llama_solidattention_kv_bridge_summary.executor_tensor_dry_run_range_count += (uint32_t) range_count;
+    llama_solidattention_kv_bridge_summary.executor_tensor_dry_run_bytes += (uint64_t) record.size_bytes;
+    llama_solidattention_kv_bridge_summary.executor_tensor_dry_run_key_bytes += key_bytes;
+    llama_solidattention_kv_bridge_summary.executor_tensor_dry_run_value_bytes += value_bytes;
+    llama_solidattention_kv_bridge_summary.executor_tensor_dry_run_checksum_count += 3;
+    llama_solidattention_kv_bridge_summary.executor_tensor_dry_run_checksum_xor ^= block_checksum ^ key_checksum ^ value_checksum;
+    llama_solidattention_kv_bridge_summary.executor_tensor_dry_run_tensor_bounds_error_count += tensor_bounds_error_count;
+
+    llama_solidattention_write_tensor_dry_run_event(
+            record,
+            block_checksum,
+            key_checksum,
+            value_checksum,
+            tensor_bounds_error_count);
+}
